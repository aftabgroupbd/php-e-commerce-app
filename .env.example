# Copy this file to ".env" and adjust the values for your machine.
# ".env" is ignored by git so real credentials never end up in the repository.

# "development" shows detailed errors, "production" hides them and only logs.
APP_ENV=development
APP_NAME="Mini Shop"

# Base URL path the application is served from.
# Use "" (empty) when you run: php -S localhost:8000 -t public
APP_BASE_PATH=

DB_HOST=localhost
DB_PORT=3306
DB_NAME=hw
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
