# Apache configuration for the public folder.
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Serve real files (CSS, images, uploads) directly ...
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # ... and send everything else to the front controller.
    RewriteRule ^ index.php [QSA,L]
</IfModule>
